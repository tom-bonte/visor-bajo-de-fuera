rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@visor.local';
    }

    // =========================================================================
    // 1. VISOR BAJO DE FUERA (sin cambios en esta ronda)
    // =========================================================================

    // Calendario diario de Bajo de Fuera
    match /bdf_days/{dayId} {
      // Cualquier usuario (incluido modo consulta/invitado) puede leer el calendario
      allow read: if true;
      // Solo usuarios autenticados (centros de buceo o admin) pueden añadir o modificar plazas
      allow create, update: if isSignedIn();
      // Solo el Administrador puede borrar un día completo
      allow delete: if isAdmin();
    }

    // Registro de auditoría / historial
    match /bdf_history_logs/{logId} {
      // Lectura pública/centros para la pestaña de Historial
      allow read: if true;
      // Solo usuarios autenticados pueden registrar eventos de auditoría
      allow create: if isSignedIn();
      // Nadie puede alterar ni borrar el historial (inmutable), excepto Admin
      allow update, delete: if isAdmin();
    }

    // Solicitudes activas de intercambio y peticiones de plazas
    match /bdf_requests/{requestId} {
      // Solo centros autenticados pueden ver, crear, responder o cancelar solicitudes
      allow read, create, update, delete: if isSignedIn();
    }

    // =========================================================================
    // 2. VISOR RESERVA CABO DE PALOS
    // =========================================================================
    // Lectura pública: la app tiene modo consulta sin login, y además la app
    // Mangamar lee 'reservations_monthly' para poblar sus salidas.
    // Escritura solo autenticada: el visor CdP nunca escribe sin sesión iniciada
    // (no realiza ninguna escritura al cargar la página).

    match /reservations_monthly/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /swaps/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /history_logs/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /config/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =========================================================================
    // 3. APP MANGAMAR (comportamiento IDÉNTICO al actual, sin cambios)
    // =========================================================================
    // Se mantiene el acceso tal y como está hoy mientras se confirma su modelo
    // de autenticación (personal = solo lectura, gerencia = escritura).
    // PENDIENTE: restringir en una segunda fase.
    match /{col}/{doc=**} {
      allow read, write: if col.matches('^mangamar_.*');
    }

    // Cualquier colección no contemplada arriba queda denegada por defecto.
  }
}
