rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // IDENTIDAD
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@visor.local';
    }

    // 'mangamar@visor.local' -> 'mangamar'
    function userKey() {
      return isSignedIn() ? request.auth.token.email.split('@')[0] : '';
    }

    // 'mangamar@visor.local' -> 'M'.  Cadena vacía si no es un centro conocido.
    function myCenter() {
      return {
        'moondive': 'MD', 'hormigas': 'H', 'mangamar': 'M', 'naranjito': 'N',
        'planeta': 'P', 'divers': 'D', 'club': 'C', 'xlm': 'X'
      }.get(userKey(), '');
    }

    // =========================================================================
    // VALIDACIÓN DE UN DÍA DE BAJO DE FUERA
    // =========================================================================
    // No se puede expresar "sólo puedes tocar tus plazas": un intercambio o una
    // cesión modifican legítimamente los registros de DOS escuelas en la misma
    // escritura. Lo que sí se garantiza aquí es que ningún cliente (ni con la
    // consola abierta) pueda dejar el día en un estado imposible.

    function validCenterCode(c) {
      return c is string && c in ['MD', 'H', 'M', 'N', 'P', 'D', 'C', 'X'];
    }

    function validSalida(s) {
      return s.plazas is int
          && s.plazas > 0
          && s.plazas <= 30
          && validCenterCode(s.centerCode)
          && (!('note' in s) || (s.note is string && s.note.size() <= 200));
    }

    // Section 0: como máximo un registro por escuela y día, y hay 8 escuelas.
    function salidaOkAt(list, i) {
      return i >= list.size() || validSalida(list[i]);
    }

    function plazasAt(list, i) {
      return i < list.size() ? list[i].plazas : 0;
    }

    // Tope duro de 30 (el cupo diario máximo posible). El cupo exacto de cada
    // fecha (13 o 30 según temporada) lo sigue aplicando la app; esto es la red
    // de seguridad para que nunca se pueda sobrepasar el máximo absoluto.
    function totalPlazasOk(list) {
      return (plazasAt(list, 0) + plazasAt(list, 1) + plazasAt(list, 2) + plazasAt(list, 3)
            + plazasAt(list, 4) + plazasAt(list, 5) + plazasAt(list, 6) + plazasAt(list, 7)) <= 30;
    }

    function salidasValid(list) {
      return list is list
          && list.size() <= 8
          && salidaOkAt(list, 0) && salidaOkAt(list, 1) && salidaOkAt(list, 2) && salidaOkAt(list, 3)
          && salidaOkAt(list, 4) && salidaOkAt(list, 5) && salidaOkAt(list, 6) && salidaOkAt(list, 7)
          && totalPlazasOk(list);
    }

    function dayWriteValid() {
      return !('salidas' in request.resource.data)
          || salidasValid(request.resource.data.salidas);
    }

    // ¿Soy una de las dos escuelas nombradas en la solicitud?
    // Comprueba la existencia del documento y de los campos: si se evalúa
    // `resource.data.x` sobre un documento inexistente la regla no devuelve
    // false, sino un ERROR de evaluación (deniega igual, pero ensucia los
    // registros y es más difícil de razonar).
    function isRequestParty() {
      return resource != null
          && (('initiatorCenter' in resource.data && resource.data.initiatorCenter == myCenter())
           || ('targetCenter' in resource.data && resource.data.targetCenter == myCenter()));
    }

    // =========================================================================
    // 1. VISOR BAJO DE FUERA
    // =========================================================================

    // Calendario diario
    //
    // LAS ESCUELAS YA NO ESCRIBEN AQUÍ. Desde el 20/09/2026 sus cambios pasan
    // por netlify/functions/bdf-write.js, que comprueba con el token de sesión
    // quién eres y vuelve a leer el día antes de tocarlo. Esa función usa una
    // cuenta de servicio, que no pasa por estas reglas.
    //
    // Lo que estas reglas hacen ahora es cerrar la puerta de atrás: un centro
    // con la consola del navegador abierta ya no puede reescribir el día y
    // borrar los barcos de los demás. Sólo queda abierta la del administrador,
    // que es una única cuenta de Tom, para el cuadrante CSV y el intercambio
    // directo; y aun así el día tiene que quedar válido.
    match /bdf_days/{dayId} {
      // Cualquier usuario (incluido modo consulta/invitado) puede leer el calendario
      allow read: if true;
      allow create, update: if isAdmin() && dayWriteValid();
      allow delete: if isAdmin();
    }

    // Registro de auditoría / historial
    match /bdf_history_logs/{logId} {
      // Lectura pública/centros para la pestaña de Historial
      allow read: if true;
      // El historial de las escuelas lo escribe la función del servidor, dentro
      // de la misma operación que cambia las plazas: así el registro no puede
      // discrepar del dato. Desde el navegador sólo escribe el administrador
      // (cuadrante CSV, cupos e intercambio directo).
      allow create: if isAdmin();
      // Historial inmutable salvo para el Admin
      allow update, delete: if isAdmin();
    }

    // Solicitudes de intercambio, peticiones y cesiones
    match /bdf_requests/{requestId} {
      allow read: if isSignedIn();

      // Proponer, aceptar, rechazar y retirar pasan por la función del servidor,
      // que comprueba que eres quien dices ser y que eres parte de la solicitud.
      // Desde el navegador no se escribe: así nadie puede crear una propuesta a
      // nombre de otra escuela (lo que disparaba un WhatsApp firmado por ella)
      // ni aceptarse a sí mismo las plazas de un tercero.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. VISOR RESERVA CABO DE PALOS
    // =========================================================================
    // Lectura pública: modo consulta sin login, y la app Mangamar lee
    // 'reservations_monthly' para poblar sus salidas.

    match /reservations_monthly/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /swaps/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /history_logs/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /config/{doc=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =========================================================================
    // 3. APP MANGAMAR
    // =========================================================================
    // Quién entra en mangamar_* (y nadie más):
    //
    //   a) DISPOSITIVOS APROBADOS (lo normal desde el 22/09/2026). Los móviles
    //      y PCs del personal no escriben nada: cada navegador que ya ha entrado
    //      como personal pide solo un "pase de dispositivo" a
    //      netlify/functions/device.js. El pase es un token 'custom' de Firebase
    //      con uid 'dev_<id>' y la marca mgDevice: true, firmado con la cuenta
    //      de servicio: sólo el servidor puede fabricarlo. Además, el servidor
    //      guarda la ficha mangamar_devices/{uid}, y aquí se mira EN CADA
    //      PETICIÓN que esa ficha exista y diga status == 'approved'. Un
    //      dispositivo 'pending' o 'revoked', uno sin ficha, o un token 'custom'
    //      sin la marca, NO entra. Quitar un dispositivo corta su acceso al
    //      momento, aunque su token siga vivo hasta una hora.
    //
    //   b) Las dos cuentas EXACTAS de email y contraseña, como hasta ahora:
    //        - mangamar@visor.local  la cuenta de la tienda
    //        - admin@visor.local     la cuenta de Tom
    //      Nunca "cualquiera con sesión" ni "cualquier @visor.local": las otras
    //      escuelas del Visor también tienen cuentas @visor.local. Un token
    //      'custom' o anónimo que traiga el mismo email NO vale.
    //
    // Cada colección va por su nombre exacto. Una colección mangamar_ nueva, o
    // una subcolección no listada aquí, queda DENEGADA.
    //
    // Fuera de estas reglas (usan cuenta de servicio o IAM, no pasan por aquí):
    //   - el portal de clientes (netlify/functions/portal.js), que es el único
    //     que escribe mangamar_portal_throttle y mangamar_portal_logs;
    //   - el registro de dispositivos (netlify/functions/device.js), que es el
    //     único que crea fichas en mangamar_devices y el único que escribe
    //     secretHash, role, ua, createdAt, lastSeen y approvedBy;
    //   - Make.com, que crea los documentos de mangamar_inbox;
    //   - la copia de seguridad nocturna y la restauración (Admin SDK).
    // Por eso aquí no hay NINGÚN acceso sin sesión a mangamar_*.

    function mgIsPasswordUser() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function mgIsAdmin() {
      return mgIsPasswordUser()
          && request.auth.token.email == 'admin@visor.local';
    }

    // exists() antes de get(): si no hay ficha, deniega limpio en vez de dar
    // un error de evaluación.
    function mgIsDevice() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'custom'
          && request.auth.token.get('mgDevice', false) == true
          && exists(/databases/$(database)/documents/mangamar_devices/$(request.auth.uid))
          && get(/databases/$(database)/documents/mangamar_devices/$(request.auth.uid)).data.get('status', '') == 'approved';
    }

    function mgIsStaff() {
      return mgIsDevice()
          || (mgIsPasswordUser()
              && request.auth.token.email in ['mangamar@visor.local', 'admin@visor.local']);
    }

    // Salidas por mes (YYYY-MM) y los documentos fijos staff, reg_maintenance,
    // tank_inventory y tank_actas. La app nunca borra un documento entero
    // (sólo campos), así que borrar el documento queda para Tom.
    match /mangamar_monthly/{mgDocId} {
      allow read, create, update: if mgIsStaff();
      allow delete: if mgIsAdmin();
    }

    // Fichas de clientes (el id es el DNI, 'VENTA DIRECTA' o 'temp_...') y su
    // historial. La app sí borra fichas e historial (cambio de DNI, borrar
    // cliente, mover buceadores), así que la tienda puede borrar.
    match /mangamar_customers/{mgCustomerId} {
      allow read, write: if mgIsStaff();

      match /history/{mgHistoryId} {
        allow read, write: if mgIsStaff();
      }
    }

    // Consultas collectionGroup('history'): certificados pendientes y
    // procesados, deudas, contabilidad y la herramienta de borrado.
    // SÓLO LECTURA. Por cómo funciona Firestore, esto se aplica a cualquier
    // subcolección 'history' del proyecto (hoy sólo existe bajo
    // mangamar_customers). No añadir NUNCA escritura aquí: la escritura va por
    // la ruta completa de arriba.
    match /{mgPath=**}/history/{mgHistoryId} {
      allow read: if mgIsStaff();
    }

    // Directorio: master_list, master_list_N (el CRM entero) y settings.
    // settings incluye adminPassword: ya no está reservado a Tom, porque
    // ningún dispositivo entra como admin y "Cambiar contraseña" tiene que
    // seguir funcionando desde los dispositivos del personal.
    // La app nunca borra estos documentos: borrarlos queda para Tom.
    match /mangamar_directory/{mgDocId} {
      allow read, create, update: if mgIsStaff();
      allow delete: if mgIsAdmin();
    }

    match /mangamar_groups/{mgDocId} {
      allow read, write: if mgIsStaff();
    }

    // Altas de Jotform. Las crea Make.com (IAM, fuera de estas reglas); la
    // tienda las lee, las pasa al directorio y las borra.
    match /mangamar_inbox/{mgDocId} {
      allow read, delete: if mgIsStaff();
    }

    // Registro de accesos al portal. Lo escribe sólo el servidor; la tienda
    // lo consulta.
    match /mangamar_portal_logs/{mgDocId} {
      allow read: if mgIsStaff();
    }

    // mangamar_portal_throttle: SIN regla a propósito. Sólo el servidor.

    // Registro de dispositivos ("Dispositivos conectados"). Lo crea y lo
    // mantiene SÓLO el servidor (netlify/functions/device.js): el alta, el
    // aprobar y el quitar (que además corta la sesión de Firebase del quitado).
    // Desde el navegador sólo se puede leer la lista, y sólo con acceso.
    match /mangamar_devices/{mgDeviceUid} {
      allow read: if mgIsStaff();
      allow create, update, delete: if false;
    }

    match /mangamar_bonos/{mgDocId} {
      allow read, write: if mgIsStaff();
    }

    match /mangamar_contacts/{mgDocId} {
      allow read, write: if mgIsStaff();
    }

    match /mangamar_projects/{mgDocId} {
      allow read, write: if mgIsStaff();
    }

    // pricing (tarifas) y device_checkins (cada dispositivo de la tienda
    // anota con merge { [deviceId]: {email, build, at, ua} }).
    // La app nunca borra estos documentos: borrarlos queda para Tom.
    match /mangamar_settings/{mgDocId} {
      allow read, create, update: if mgIsStaff();
      allow delete: if mgIsAdmin();
    }

    match /mangamar_staff_schedule/{mgDocId} {
      allow read, write: if mgIsStaff();
    }

    // Cualquier colección no contemplada arriba queda denegada por defecto.
  }
}
